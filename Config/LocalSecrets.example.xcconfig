// Copy to Config/LocalSecrets.xcconfig and fill in your real values.
// GitHub Actions uses vars.SPARKLE_PUBLIC_ED_KEY and secrets.SPARKLE_PRIVATE_ED_KEY.
// xcconfig treats `//` as the start of a comment, so build URLs via a slash helper.

_XC_SLASH = /
// Leave both empty for manual-install builds; use your own matching Sparkle key pair.
// Example feed: https:$(_XC_SLASH)/github.com/OWNER/REPO/releases/latest/download/appcast.xml
SPARKLE_APPCAST_URL =
SPARKLE_PUBLIC_ED_KEY =

// Optional anonymous product telemetry upload target.
// Release builds should inject the full SLS target from GitHub Actions secrets.
// Use the SLS region endpoint host only, for example: ap-southeast-1.log.aliyuncs.com
TRAE_FLOW_TELEMETRY_SLS_HOST =
TRAE_FLOW_TELEMETRY_SLS_PROJECT =
TRAE_FLOW_TELEMETRY_SLS_LOGSTORE =
